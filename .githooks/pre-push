#!/bin/sh
# pre-push: 推送到远端前的本地闸门
# 安装（换机后）：git config core.hooksPath .githooks
# 设计原则（单人维护、无 CI）：
#   - 始终校验，不依赖 [ -t 1 ]（Git for Windows 下经 shell 调用时 tty 判定不可靠，会导致校验被静默跳过）
#   - 显式逃逸口：git push --no-verify
#   - 校验失败即 exit 1 阻止 push，错误信息直接输出到终端

# ── 0: 保存 stdin（LFS 上传与分支检测都需要）──
TMP_STDIN=$(mktemp)
cat > "$TMP_STDIN"

# ── 1: LFS 对象上传（必须最先执行，依赖 stdin 中的 refs 信息）──
if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@" < "$TMP_STDIN"
  if [ $? -ne 0 ]; then
    echo "LFS 对象上传失败，已中止 push。"
    echo "   手动重试：git lfs push --all origin master"
    rm -f "$TMP_STDIN"
    exit 1
  fi
else
  echo "警告: git-lfs 未安装，LFS 对象不会随 push 上传（Release 归档会失败）。"
fi

# ── 2: T1: README / deploy-doc vs agents model consistency ──
pwsh -File ".opencode/tests/T1-readme-consistency.ps1" >/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "T1 一致性检查失败：README / 部署手册与 .opencode/agents 的 model 分配不一致。"
  echo "   请先同步（改 agents 的 model 后，同步 7 个 README 图表 + 2 个部署手册），再 push。"
  echo "   跳过检查：git push --no-verify"
  rm -f "$TMP_STDIN"
  exit 1
fi

# ── 3: 图片锚点规范：ARCH-IMG/COST-IMG 锚点存在、不进代码块、不含 opengraph ──
pwsh -File "scripts/verify-images.ps1" >/dev/null 2>&1
if [ $? -ne 0 ]; then
  echo "README 图片锚点校验失败：架构图/降本卡不在锚点内、或落在代码块内、或误引 opengraph。"
  echo "   请跑 pwsh scripts/verify-images.ps1 看明细，修复后重试 push。"
  echo "   跳过检查：git push --no-verify"
  rm -f "$TMP_STDIN"
  exit 1
fi

# ── 4: master 发版提示（仅提示，不阻断）──
master_push=0
while read -r lref lobj rref robj; do
  [ "$lref" = "refs/heads/master" ] && master_push=1
done < "$TMP_STDIN"
rm -f "$TMP_STDIN"
[ "$master_push" -eq 0 ] && exit 0

remote="$1"
if git diff --quiet "$remote/master" HEAD -- CHANGELOG.md 2>/dev/null; then
  exit 0
fi

VER=$(grep -m1 -E '^## +v[0-9]+\.[0-9]+\.[0-9]+' CHANGELOG.md | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+')
[ -z "$VER" ] && exit 0

echo "即将发版：$VER"
echo "   CHANGELOG.md 有改动，push 后会自动：打 tag + 建 Release + 上传 zip/tar.gz 归档。"
echo "   （单人维护，自动继续；如需取消请 Ctrl+C）"
