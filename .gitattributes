*.png filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text

# 历史遗留：以下文件以普通 blob 提交（非 LFS 指针），保持现状不迁移
.github/moa-arch*.png !filter !diff !merge -text
.github/moa-cost*.png !filter !diff !merge -text
.github/moa-social-zh.png !filter !diff !merge -text

# 脚本与配置统一 LF（防 Windows autocrlf 检出/提交 CRLF 混入，跨平台协作一致）
* text=auto
*.ps1 text eol=lf
*.psm1 text eol=lf
*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# 钩子无扩展名，不受上述规则覆盖（实测 eol: unspecified）；强制 LF 防 Windows autocrlf 检出 CRLF 致 shebang 失效
.githooks/* text eol=lf
